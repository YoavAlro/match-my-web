{
  "name": "tweaksy-extension",
  "version": "0.13.0",
  "private": true,
  "description": "Privacy-first Chrome extension for conversational website adaptations.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:site": "npm run build:web && npm run stage:site && vinext build",
    "dev": "node scripts/build.mjs --watch",
    "dev:web": "npm run build:web && node scripts/serve-web.mjs",
    "dev:site": "npm run build:web && npm run stage:site && vinext dev",
    "stage:site": "node scripts/stage-site-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build:site && npm run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@cloudflare/workers-types": "5.20260828.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/chrome": "^0.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "esbuild": "0.28.2",
    "sharp": "0.35.4",
    "typescript": "^5.9.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.0"
  }
}
